# Copy to .env and fill in. Variables set in the real environment take
# precedence over this file.

# HTTP server
PORT=3007
# Interface to bind. Leave unset to listen on all interfaces; use 127.0.0.1
# when the server sits behind a reverse proxy on the same machine.
# HOST=127.0.0.1

# PostgreSQL (standard libpq variable names)
PGHOST=localhost
PGPORT=5432
PGDATABASE=osm
# The server only reads; a read-only role is recommended (see README).
PGUSER=postgres
PGPASSWORD=
# Or a single connection string, which overrides the PG* values above:
# DATABASE_URL=postgres://user:password@localhost:5432/osm

# Admin panel (/#/admin), live stats socket and request log stream.
# Leave unset to disable them. Must be at least 16 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Where request counters are persisted. Defaults to stats.json next to server.js.
# STATS_FILE=/var/lib/origin/stats.json
